rule extract_reads_overlapping_start_codons_and_calculate_offsets:
    """
    extract uniquely mapped, non-split reads overlapping with annotated start codons - in bed format
    calculate offsets - distance between read 5'end and P-site (1st nt position in the start codon)
    """
    input:
        bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.bam.bai",
        ),
        bed = config["start_codons_bed"],
    output:
        read_overlaps=os.path.join(
            config["output_dir"],
            "reads_overlapping_start_codons",
            "{sample}.length_{length}.overlapping_start_codons.tsv.gz",
        ),
        offset_abundance_plus_strand=os.path.join(
            config["output_dir"],
            "reads_overlapping_start_codons",
            "{sample}.length_{length}.offset_abundance.plus_strand.tsv",
        ),
        offset_abundance_minus_strand=os.path.join(
            config["output_dir"],
            "reads_overlapping_start_codons",
            "{sample}.length_{length}.offset_abundance.minus_strand.tsv",
        ),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "reads_overlapping_start_codons"),
        valid_offset_range_min = int(config["valid_Psite_offsets"].split('-')[0]),
        valid_offset_range_max = int(config["valid_Psite_offsets"].split('-')[1]),
    conda:
        "envs/samtools_latest.yaml"
    threads: 4
    resources:
        mem_mb=5000,
        runtime=30,
    log:
        os.path.join(config["local_log"],"extract_reads_overlapping_start_codons_and_calculate_offsets_{sample}_{length}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        samtools view -u -q 255 {input.bam} | bedtools bamtobed -cigar -i stdin | awk -F'\t' '($7 !~ /N/ && $7 !~ /*/ && $7 !~ /D/)' | \
        cut -f1-6 | sort -k1,1 -k2,2n | bedtools intersect -sorted -wa -wb -s -F 1 -a stdin -b {input.bed} | \
        cut -f1,2,3,6,8,9 | \
        pigz --fast -p {threads} -c -f > {output.read_overlaps}; \
        zcat {output.read_overlaps} | awk -F'\t' '$4 == "+"' | awk -F'\t' '{{print $5 - $2}}' | \
        sort -n | uniq -c | awk '$2 >= {params.valid_offset_range_min} && $2 <= {params.valid_offset_range_max} {{ print $1 "\t" $2 }}' | sort -k1nr > {output.offset_abundance_plus_strand}; \
        zcat {output.read_overlaps} | awk -F'\t' '$4 == "-"' | awk -F'\t' '{{print $3 - $6}}' | \
        sort -n | uniq -c | awk '$2 >= {params.valid_offset_range_min} && $2 <= {params.valid_offset_range_max} {{ print $1 "\t" $2 }}' | sort -k1nr > {output.offset_abundance_minus_strand}; \
        ) &> {log}"""

rule quantify_Psites:
    """
        use only uniquely mapped reads
        use the most likely (most abundant) offset
        accordingly transform the reads to bedgraph and bigwig formats
        quantify each phase of the CDSs
    """
    input:
        bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.bam.bai",
        ),
        offset_abundance_plus_strand=os.path.join(
            config["output_dir"],
            "reads_overlapping_start_codons",
            "{sample}.length_{length}.offset_abundance.plus_strand.tsv",
        ),
        offset_abundance_minus_strand=os.path.join(
            config["output_dir"],
            "reads_overlapping_start_codons",
            "{sample}.length_{length}.offset_abundance.minus_strand.tsv",
        ),
        genome_fai = config["genome_file"]+'.fai',
        bed_codon_annotation_plus = config["bed_codon_annotation_plus"],
        bed_codon_annotation_minus = config["bed_codon_annotation_minus"],
        script=os.path.join(workflow.basedir, "scripts", "get_Psite_bed_file.py"),
    output:
        bigwig_plus = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.plus.bigwig"),
        bigwig_minus = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.minus.bigwig"),
        tsv_sum_over_codons = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.over_codons.tsv"),
        tsv_sum_over_genes = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.over_genes.tsv"), 

    params:
        outdir = os.path.join(
            config["output_dir"],
            "Psites"),
        bed_reads = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.sorted.bed"),
        bed_Psites_plus = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.Psites.sorted.plus.bed"),
        bed_Psites_minus = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.Psites.sorted.minus.bed"),
        bg_plus = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.Psites.sorted.plus.bedgraph"),
        bg_minus = os.path.join(
                        config["output_dir"],
                        "Psites",
                        "{sample}.length_{length}.Psites.sorted.minus.bedgraph"),
        min_overlap = 3,
    conda:
        "envs/samtools_latest.yaml"
    threads: 12
    resources:
        mem_mb=10000,
        runtime=29,
        qos='30min',
    log:
        os.path.join(config["local_log"],"quantify_Psites_{sample}_{length}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        offset_plus=$(head -n 1 {input.offset_abundance_plus_strand} | awk -F'\t' '{{print $2}}'); \
        number_plus=$(head -n 1 {input.offset_abundance_plus_strand} | awk -F'\t' '{{print $1}}'); \
        offset_minus=$(head -n 1 {input.offset_abundance_minus_strand} | awk -F'\t' '{{print $2}}'); \
        number_minus=$(head -n 1 {input.offset_abundance_minus_strand} | awk -F'\t' '{{print $1}}'); \
        if [[ $offset_plus -ne $offset_minus ]]; then \
            echo "optimal offsets are not equal for plus and minus strands"; \
            if [[ $number_plus -gt $number_minus ]]; then \
                offset=$offset_plus; \
            else offset=$offset_minus; \
            fi; \
        else \
            offset=$offset_plus; \
        fi; \
        if [[ $offset -eq '' ]]; then echo "empty files"; offset=-1; fi; \
        echo $offset; \
        if [[ $offset -ne -1 ]]; then \
            samtools view -@ {threads} -h -q 255 -u {input.bam} | \
            bedtools bamtobed -cigar -i stdin | sort -k 1,1 -k2,2n > {params.bed_reads}; \
            python3 {input.script} \
            --input_bed_file {params.bed_reads} \
            --output_bed_file_plus {params.bed_Psites_plus} \
            --output_bed_file_minus {params.bed_Psites_minus} \
            --offset $offset; \
            cat {params.bed_Psites_plus} | bedtools genomecov -i stdin -g {input.genome_fai} -bg > {params.bg_plus} && \
            bedGraphToBigWig {params.bg_plus} {input.genome_fai} {output.bigwig_plus} && \
            bedtools intersect -sorted -wa -wb -a {input.bed_codon_annotation_plus} -b {params.bg_plus} | cut -f1,3,4,5,6,10 | \
            awk -F'\t' '{{ split($3, a, ";"); num_overlapping_trs = a[3]; codon_number = a[2]; transcript_id = a[1]; OFS="\t"; print transcript_id, codon_number, num_overlapping_trs, $4, $6 }}' > {output.tsv_sum_over_codons}; \
            cat {params.bed_Psites_minus} | bedtools genomecov -i stdin -g {input.genome_fai} -bg > {params.bg_minus} && \
            bedGraphToBigWig {params.bg_minus} {input.genome_fai} {output.bigwig_minus} && \
            bedtools intersect -sorted -wa -wb -a {input.bed_codon_annotation_minus} -b {params.bg_minus} | cut -f1,3,4,5,6,10 | \
            awk -F'\t' '{{ split($3, a, ";"); num_overlapping_trs = a[3]; codon_number = a[2]; transcript_id = a[1]; OFS="\t"; print transcript_id, codon_number, num_overlapping_trs, $4, $6 }}' >> {output.tsv_sum_over_codons}; \
            cat {output.tsv_sum_over_codons} | awk -F'\t' 'BEGIN {{OFS="\t"}} {{$6 = $5 / $3; print}}' | \
            awk -F'\t' '{{sum[$1"_ppp_"$4]+=$6}} END {{OFS="\t"; for (i in sum) {{split(i, a, "_ppp_"); print a[1], a[2], sum[i]}}}}' | sort -k 1,1 -k2,2n > {output.tsv_sum_over_genes}; \
            rm -f {params.bed_reads} {params.bed_Psites_plus} {params.bed_Psites_minus} {params.bg_plus} {params.bg_minus}; \
        else \
        echo '' > {output.bigwig_plus}; echo '' > {output.bigwig_minus}; echo '' > {output.tsv_sum_over_codons}; echo '' > {output.tsv_sum_over_genes}; fi; \
        ) &> {log}"""

