rule create_index_star:
    """
        Create index for STAR alignments
    """
    input:
        genome=config["genome_file"],
        gtf = config["gtf_file"],
    output:
        chromosome_info=os.path.join(
            config["output_dir"],
            "STAR_indices",
            config["organism"],
            "with_GTF_genome",
            "STAR_index",
            "chrNameLength.txt",
        ),
        chromosomes_names=os.path.join(
            config["output_dir"],
            "STAR_indices",
            config["organism"],
            "with_GTF_genome",
            "STAR_index",
            "chrName.txt",
        ),
    params:
        output_dir=lambda wildcards, output: os.path.dirname(output.chromosome_info),
        outFileNamePrefix=os.path.join(
            config["output_dir"],"STAR_indices", config["organism"], "with_GTF_genome", "STAR_index/STAR_"
        ),
        sjdbOverhang = 100
    conda:
        "envs/STAR.yaml"
    threads: 16
    resources:
        mem_mb=80000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"create_index_star.log"),
    shell:
        """(mkdir -p {params.output_dir}; \
        STAR \
        --runMode genomeGenerate \
        --genomeDir {params.output_dir} \
        --genomeFastaFiles {input.genome} \
        --runThreadN {threads} \
        --outFileNamePrefix {params.outFileNamePrefix} \
        --sjdbGTFfile {input.gtf} \
        ) \
        &> {log}"""

rule map_genome_star:
    """
        Map to genome using STAR;
        In Ribo-seq we should do End-to-End alignment, because read lengths are important to assign phase
        also remove secondary alignments
    """
    input:
        chromosome_info = os.path.join(
            config["output_dir"],
            "STAR_indices",
            config["organism"],
            "with_GTF_genome",
            "STAR_index",
            "chrNameLength.txt",
        ),
        reads=os.path.join(
            config["output_dir"],
            "fastq",
            "length_separated",
            "{sample}.{length}.R1.fastq.gz"),
    output:
        bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.bam",
        ),
        bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.bam.bai",
        ),
        filtered_bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        filtered_bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Aligned.sortedByCoord.out.no_secondary.bam.bai",
        ),
        log_final_file=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.length_{length}.Log.final.out",
        ),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "map_genome"),
        STAR_index_dir = lambda wildcards, input: os.path.dirname(input.chromosome_info),
        outFileNamePrefix=lambda wildcards, output: output.bam.replace(
            "Aligned.sortedByCoord.out.bam", ""
        ),       
    conda:
        "envs/STAR.yaml"
    threads: 4
    resources:
        mem_mb=20000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"map_genome_star__{sample}_{length}.log")
    shell:
