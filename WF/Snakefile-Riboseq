rule define_present_read_lengths:
    """
        calculate the abundance of each present read length in the samples;
        the outcome does not directly affect further separation by read lengths, which is instead defined by configuration
    """
    input:
        input_reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "2.trimmed_adapters_2round",            
            "{sample}.R1.fastq.gz"),
    output:
        read_stats=os.path.join(
            config["output_dir"],
            "read_stats",
            "{sample}.read_length_abundance.tsv",
        )
    params:
        outdir = os.path.join(
            config["output_dir"],
            "read_stats"),
    conda:
        "envs/seqkit_282.yaml"
    threads: 4
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"define_present_read_lengths_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        zcat {input.input_reads_R1} | seqkit seq -s | awk '{{ print length($0) }}' | sort -n | uniq -c | awk '{{ print $1 "\t" $2 }}' | sort -k1nr > {output.read_stats}; \
        ) &> {log}"""

rule separate_by_read_lengths:
    """
        select specific length
    """
    input:
        input_reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "2.trimmed_adapters_2round",            
            "{sample}.R1.fastq.gz"),
    output:
        length_separated_reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "length_separated",
            "{sample}.{length}.R1.fastq.gz"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "fastq",
            "length_separated"),
        length = '{length}'
    conda:
        "envs/seqkit_282.yaml"
    threads: 4
    resources:
        mem_mb=10000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"separate_by_read_lengths_{sample}_{length}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        zcat {input.input_reads_R1} | seqkit seq -m {params.length} -M {params.length} -w 0 | \
        pigz --fast -p {threads} -c -f > {output.length_separated_reads_R1}; \
        ) &> {log}"""

