rule index_genome:
    """
        use samtools to index genome
    """
    input:
        genome = config["genome_file"],
    output:
        genome_fai = config["genome_file"]+'.fai'
    conda:
        "envs/samtools_latest.yaml"
    threads: 12
    resources:
        mem_mb=80000,
        runtime=240,
    log:
        os.path.join(config["local_log"],"index_genome.log"),
    shell:
        """(set +o pipefail; \
        samtools faidx -@ {threads} {input.genome}) \
        &> {log}"""


rule fastqc_input:
    """
        A quality control tool for high throughput sequence data
    """
    input:
        reads_R1=lambda wildcards: samples.loc[wildcards.sample, "fq1"],
    output:
        outdir_R1=directory(os.path.join(
            config["output_dir"],
            "fastqc",
            "0.input.R1",
            "{sample}")),
    params:
        reads_R2=lambda wildcards: samples.loc[wildcards.sample, "fq2"],
        outdir_R2=directory(os.path.join(
            config["output_dir"],
            "fastqc",
            "0.input.R2",
            "{sample}")),
    threads: 4
    resources:
        mem_mb=10000,
        runtime=29,
        qos='30min'
    singularity:
        "docker://staphb/fastqc:0.12.1"
    log:
        os.path.join(config["local_log"],"fastqc_input__{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {output.outdir_R1}; mkdir -p {params.outdir_R2}; \
        if [[ "{input.reads_R1}" =~ [^Xx[:space:]] ]]; then \
        fastqc --outdir {output.outdir_R1} \
        --threads {threads} \
        {input.reads_R1}; fi; \
        if [[ "{params.reads_R2}" =~ [^Xx[:space:]] ]]; then \
        fastqc --outdir {params.outdir_R2} \
        --threads {threads} \
        {params.reads_R2}; fi) \
        &> {log}"""

rule remove_adapters:
    """
        Remove adapters
    """
    input:
        reads_R1 = lambda wildcards: samples.loc[wildcards.sample, "fq1"],
    output:
        trimmed_reads_R1 = os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters",            
            "{sample}.R1.fastq.gz"),
    params:
        reads_R2 = lambda wildcards: samples.loc[wildcards.sample, "fq2"],
        out_trimmed_reads_R2 = os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters",            
            "{sample}.R2.fastq.gz"),
        outdir = os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters"),
        adapters_3_R1=lambda wildcards: samples.loc[wildcards.sample, "fq1_3p"],
        adapters_3_R2=lambda wildcards: samples.loc[wildcards.sample, "fq2_3p"],
        # min_read_len = lambda wildcards: samples.loc[wildcards.sample, "min_read_len"],
        min_read_len = 1,
    conda:
        "envs/cutadapt.yaml"
    threads: 10
    resources:
        mem_mb=50000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"remove_adapters__{sample}.log")
    shell:
        """(mkdir -p {params.outdir}; \
        if ! [[ "{params.reads_R2}" =~ [^Xx[:space:]] ]]; then \
        cutadapt -m {params.min_read_len} -j {threads} -a {params.adapters_3_R1} -o {output.trimmed_reads_R1} {input.reads_R1}; 
        else \
        cutadapt -m {params.min_read_len} -j {threads} -a {params.adapters_3_R1} -A {params.adapters_3_R2} -o {output.trimmed_reads_R1} -p {params.out_trimmed_reads_R2} {input.reads_R1} {params.reads_R2}; fi) \
        &> {log}"""

