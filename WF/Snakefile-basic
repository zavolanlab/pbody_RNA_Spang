    threads: 10
    resources:
        mem_mb=50000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"remove_adapters__{sample}.log")
    shell:
        """(mkdir -p {params.outdir}; \
        cutadapt -m 1 -j {threads} -u {params.R1_trim5} -U {params.R2_trim5} -a {params.R1_3p} -A {params.R2_3p} \
        -o {output.reads_R1} -p {output.reads_R2} {input.reads_R1} {input.reads_R2}; \
