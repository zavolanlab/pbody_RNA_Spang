rule count_prefix_kmers_in_reads:
    """
        We check that prefixes of input R1 reads are enriched with GGG, expected for Takara kit
        input R2 reads should have UMIs in the prefix
    """
    input:
        input_reads_R1=lambda wildcards: samples.loc[wildcards.sample, "fq1"],
        input_reads_R2=lambda wildcards: samples.loc[wildcards.sample, "fq2"],
        reads_with_extracted_UMIs_R1 = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R1.fastq.gz"),
        reads_with_extracted_UMIs_R2 = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R2.fastq.gz"),
        remove_adapters_R1 = os.path.join(
            config["output_dir"],
            "fastq",
            "no_adapters",
            "{sample}.R1.fastq.gz"),
        remove_adapters_R2 = os.path.join(
            config["output_dir"],
            "fastq",
            "no_adapters",
            "{sample}.R2.fastq.gz"),
    output:
        read_stats=os.path.join(
            config["output_dir"],
            "read_stats",
            "{sample}.read_stats.txt",
        )
    params:
        outdir = os.path.join(
            config["output_dir"],
            "read_stats"),
        prefix_length = 8,
    conda:
        "envs/seqkit_282.yaml"
    threads: 4
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"count_prefix_kmers_in_reads_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        echo '>input reads R1' > {output.read_stats}; \
        zcat {input.input_reads_R1} | seqkit subseq -r 1:{params.prefix_length} | seqkit seq -s | sort | uniq -c | sort -k 1,1 >> {output.read_stats}; \
        echo '>reads_with_extracted_UMIs R1' >> {output.read_stats}; \
        zcat {input.reads_with_extracted_UMIs_R1} | seqkit subseq -r 1:{params.prefix_length} | seqkit seq -s | sort | uniq -c | sort -k 1,1 >> {output.read_stats}; \
        echo '>adapter_trimmed R1' >> {output.read_stats}; \
        zcat {input.remove_adapters_R1} | seqkit subseq -r 1:{params.prefix_length} | seqkit seq -s | sort | uniq -c | sort -k 1,1 >> {output.read_stats}; \
        echo '>input reads R2' >> {output.read_stats}; \
        zcat {input.input_reads_R2} | seqkit subseq -r 1:{params.prefix_length} | seqkit seq -s | sort | uniq -c | sort -k 1,1 >> {output.read_stats}; \
        echo '>reads_with_extracted_UMIs R2' >> {output.read_stats}; \
        zcat {input.reads_with_extracted_UMIs_R2} | seqkit subseq -r 1:{params.prefix_length} | seqkit seq -s | sort | uniq -c | sort -k 1,1 >> {output.read_stats}; \
        echo '>adapter_trimmed R2' >> {output.read_stats}; \
        zcat {input.remove_adapters_R2} | seqkit subseq -r 1:{params.prefix_length} | seqkit seq -s | sort | uniq -c | sort -k 1,1 >> {output.read_stats}; \
        ) &> {log}"""

