rule split_fastq_into_files:
    """
        next rule uses UMItools, but UMI tools can't be parallelized
        therefore we'll separate each fastq file into chunks and process them in parallel
    """
    input:
        reads_R1=lambda wildcards: samples.loc[wildcards.sample, "fq1"],
        reads_R2=lambda wildcards: samples.loc[wildcards.sample, "fq2"],
    output:
        success_flag = os.path.join(
            config['output_dir'], 
            "success_flags",
            "{sample}.splitting_InputFastq_into_parts.success"),
    params:
        dir_with_SuccessFlags = os.path.join(
            config["output_dir"],
            "success_flags"),
        sample = "{sample}",
        outdir = os.path.join(
            config["output_dir"],
            "fastq",
            "input_split",
            "{sample}"),
        dir_FastqSymbLincs = os.path.join(
            config["output_dir"],
            "fastq",
            "input_SymbLincs"),
        number_of_parts = get_number_of_parts(),
        # symbolic links are needed only to have systematic namings after splitting
        reads_R1_SymbLinc=os.path.join(
            config["output_dir"],
            "fastq",
            "input_SymbLincs",            
            "{sample}.R1.fastq.gz"),
        reads_R2_SymbLinc=os.path.join(
            config["output_dir"],
            "fastq",
            "input_SymbLincs",            
            "{sample}.R2.fastq.gz"),
    conda:
        "envs/UMItools.yaml"
    threads: 1
    resources:
        mem_mb=30000,
        runtime=100,
    log:
        os.path.join(config["local_log"],"split_fastq_into_files__{sample}.log")

    shell:
        """(set +o pipefail; mkdir -p {params.dir_with_SuccessFlags}; mkdir -p {params.outdir}; mkdir -p {params.dir_FastqSymbLincs}; \
        rm -f {output.success_flag}; \
        rm -f {params.outdir}/{params.sample}*; \
        rm -f {params.reads_R1_SymbLinc} && ln -f -s {input.reads_R1} {params.reads_R1_SymbLinc}; \
        rm -f {params.reads_R2_SymbLinc} && ln -f -s {input.reads_R2} {params.reads_R2_SymbLinc}; \
        seqkit split2 -1 {params.reads_R1_SymbLinc} -2 {params.reads_R2_SymbLinc} -p {params.number_of_parts} -O {params.outdir} -f && \
        echo 'success' > {output.success_flag}; \
        ) &> {log}"""
                
rule extract_umi:
    """
        Extract UMIs from the beginning of R2.
        Write UMI as a comment in the headers of the output fastq file (remove existing comments before that)
    """
    input:
        success_flag = os.path.join(
            config['output_dir'], 
            "success_flags", 
            "{sample}.splitting_InputFastq_into_parts.success"),
    output:
        reads_with_extracted_UMIs_R1 = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R1.{part}.fastq.gz"),
        reads_with_extracted_UMIs_R2 = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R2.{part}.fastq.gz"),
    params:
        reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "input_split",
            "{sample}",
            "{sample}.R1.{part}.fastq.gz"),
        reads_R2=os.path.join(
            config["output_dir"],
            "fastq",
            "input_split",
            "{sample}",
            "{sample}.R2.{part}.fastq.gz"),
        outdir = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs"),
        reads_R2_tmp=os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",            
            "{sample}.R2.{part}.tmp.fastq.gz"),
        
        bc_pattern_R1 = '',
        bc_pattern_R2 = lambda wildcards: samples.loc[wildcards.sample, "fq2_UMI_len"],
        new_read_names = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R2.{part}.new_read_names.txt"),
        old_read_names = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R2.{part}.old_read_names.txt"),
        read_name_alias = os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.{part}.read_name_alias.txt"),
        log_R1 = os.path.join(config["local_log"],"extract_umi__{sample}_{part}.R1.log"),
        log_R2 = os.path.join(config["local_log"],"extract_umi__{sample}_{part}.R2.log"),
    conda:
        "envs/UMItools.yaml"
    threads: 1
    resources:
        mem_mb=50000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"extract_umi__{sample}_{part}.log")

    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        ln -f -s {params.reads_R2} {params.reads_R2_tmp} && \
        umi_tools extract \
        --stdin={params.reads_R2_tmp} \
        --bc-pattern={params.bc_pattern_R2} \
        --log={params.log_R2} | seqkit replace -p ' .+' -r '$1' -o {output.reads_with_extracted_UMIs_R2}; \
        zcat {output.reads_with_extracted_UMIs_R2} | seqkit seq -n > {params.new_read_names} && \
        cat {params.new_read_names} | awk -F'_' '{{print $1}}' > {params.old_read_names} && \
        paste -d '\t' {params.old_read_names} {params.new_read_names} > {params.read_name_alias} && \
        zcat {params.reads_R1} | seqkit replace -p ' .+' -r '$1' | \
        seqkit replace -p '(.+)$' -r '{{kv}}' -k {params.read_name_alias} -o {output.reads_with_extracted_UMIs_R1} && \
        rm {params.new_read_names} {params.old_read_names} {params.read_name_alias} {params.reads_R2_tmp}; \
        ) &> {log}"""

