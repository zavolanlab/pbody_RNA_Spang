rule FeatureCounts_genomic_DefaultGTF:
    """
        quantify how many reads support each gene, using only UM reads
    """
    input:
        bam=os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
            "{merged_sample}.sorted.redefined_NH.bam"),
        gtf = config['gtf_file'],
    output:
        out_gene_fragments_txt = os.path.join(
            config['output_dir'], 
            "gene_expression_quantification", 
            "FeatureCounts_genomic_DefaultGTF",
            "{merged_sample}.txt"),
    params:
        outdir = os.path.join(
            config['output_dir'], 
            "gene_expression_quantification", 
            "FeatureCounts_genomic_DefaultGTF"),
    conda:
        "envs/FeatureCounts.yaml"
    threads:8
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"FeatureCounts_genomic_DefaultGTF_{merged_sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        featureCounts -p --countReadPairs -O --fraction -s 2 -T {threads} -B -C -P -d 1 -D 10000000000000 \
        -t exon -g gene_id \
        -a {input.gtf} -o {output.out_gene_fragments_txt} {input.bam}) &> {log}"""

