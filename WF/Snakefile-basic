        samtools index -@ {threads} {output.filtered_bam}; ) &> {log}"""

### merge technical replicates

rule merge_technical_replicates:
    """
        merge technical replicates
    """
    input:
        bam=lambda wildcards: expand(os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        sample = list(samples.loc[samples['merged_sample']==wildcards.merged_sample]['sample'])),
    output:
        merged_bam=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
    params:
        merged_nonsorted_bam = os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.nonsorted.bam"),
        merged_sample = "{merged_sample}",
        outdir = os.path.join(
           config["output_dir"],
                        "map_genome_merged"),
        merged_bai=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam.bai"),
    conda:
        "envs/samtools_latest.yaml"
    threads: 8
    log:
        os.path.join(config["local_log"],"merge_technical_replicates_{merged_sample}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        k=0; for i in {input.bam}; do k=$(( $k+1 )); done; \
        if [[ $k > 1 ]]; then \
        samtools merge {params.merged_nonsorted_bam} {input.bam} -f -@ {threads}; \
        samtools sort -@ {threads} {params.merged_nonsorted_bam} > {output.merged_bam}; \
        samtools index -@ {threads} {output.merged_bam}; \
        rm {params.merged_nonsorted_bam}; \
        else \
        rm -f {output.merged_bam} && ln -f -s {input.bam} {output.merged_bam}; \
        rm -f {params.merged_bai} && ln -f -s {input.bam}.bai {params.merged_bai}; \
        fi; \
        ) &> {log}"""

rule dedup_based_on_UMIs:
    """
        Collapse PCR duplicates if the samples had UMIs
    """
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
    output:
        sorted_bam = os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
            "{merged_sample}.sorted.bam"),
        bai = os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
            "{merged_sample}.sorted.bam.bai"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup"),
        non_sorted_bam = os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
            "{merged_sample}.non_sorted.bam"),
    conda:
        "envs/UMItools.yaml"
    threads: 4
    resources:
        mem_mb=150000,
        runtime=1400,
    log:
        os.path.join(config["local_log"],"dedup_based_on_UMIs_{merged_sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        umi_tools dedup \
        --paired \
        --method unique \
        --unmapped-reads use \
        -I {input.bam} \
        -S {params.non_sorted_bam} && \
        samtools sort -@ {threads} {params.non_sorted_bam} > {output.sorted_bam} && \
        samtools index -@ {threads} {output.sorted_bam} && \
        rm -f {params.non_sorted_bam}; \
        ) &> {log}"""


rule redefine_NH_tags_and_quality_values:
    """
        redefine NH tags and, accordingly, quality values of the filtered reads
        because after filtering, some reads may become unique, or number of MMs decreases
    """
    input:
        bam=os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
            "{merged_sample}.sorted.bam"),
        script=os.path.join(workflow.basedir, "scripts", "redefine_qual_and_NHtag.py"),
    output:
        sorted_bam=os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
           "{merged_sample}.sorted.redefined_NH.bam",
        ),
        bai=os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
           "{merged_sample}.sorted.redefined_NH.bam.bai",
        )
    params:
        outdir = os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup"),
        non_sorted_bam=os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
           "{merged_sample}.redefined_NH.bam",
        )
    conda:
        "envs/seqio.yaml"
    threads: 8
    resources:
        mem_mb=80000,
        runtime=350,
    log:
        os.path.join(config["local_log"],"redefine_NH_tags_and_quality_values_{merged_sample}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        python3 {input.script} \
        --input_bam_file {input.bam} \
        --out_bam_file {params.non_sorted_bam}; \
        samtools sort -@ {threads} {params.non_sorted_bam} > {output.sorted_bam} && \
        samtools index -@ {threads} {output.sorted_bam} && \
        rm -f {params.non_sorted_bam}; \
        ) \
        &> {log}"""

###
# checking the properties of alignments on different stages
###

rule count_UM_MM_reads_from_different_mapping_steps:
    """
        Count the abundance of UM/MM reads on different steps of mapping
        write to the ouput text file, line after line
    """
    input:
        bam_genome=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
        bam_genome_UMIdedup=os.path.join(
            config["output_dir"],
            "map_genome_merged_UMIdedup",
            "{merged_sample}.sorted.redefined_NH.bam"),
    output:
        mapping_stats=os.path.join(
            config["output_dir"],
            "mapping_stats",
            "{merged_sample}.mapping_stats.txt"),
        success_flag=os.path.join(
            config["output_dir"],
            "mapping_stats",
            "{merged_sample}.success"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "mapping_stats"),
    conda:
        "envs/samtools_latest.yaml"
    threads: 12
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"count_UM_MM_reads_from_different_mapping_steps_{merged_sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        rm -f {output.success_flag}; \
        echo '>number of UM reads; genomic mapping' > {output.mapping_stats}; \
        samtools view -@ {threads} -q 255 {input.bam_genome} | cut -f1 | sort | uniq | wc -l >> {output.mapping_stats}; \
        echo '>total number of mapped reads; genomic mapping' >> {output.mapping_stats}; \
        samtools view -@ {threads} {input.bam_genome} | cut -f1 | sort | uniq | wc -l >> {output.mapping_stats}; \
        echo '>number of UM reads; UMI dedup' >> {output.mapping_stats}; \
        samtools view -@ {threads} -q 255 {input.bam_genome_UMIdedup} | cut -f1 | sort | uniq | wc -l >> {output.mapping_stats}; \
        echo '>total number of mapped reads; UMI dedup' >> {output.mapping_stats}; \
        samtools view -@ {threads} {input.bam_genome_UMIdedup} | cut -f1 | sort | uniq | wc -l >> {output.mapping_stats}; \
        echo 'success' > {output.success_flag}; \
        ) &> {log}"""

