# for splitting fastq files, for faster, parallelized processing in UMItools
# we can set any number from 2 to 999 here
def get_number_of_parts():
    return '3'

# we can separate fastq in up to 999 parts, not more
def get_elem_str(elem):
    if elem<10 and elem>0:
        return 'part_00'+str(elem)
    elif elem>=10 and elem<100:
        return 'part_0'+str(elem)
    elif elem>=100 and elem<1000:
        return 'part_'+str(elem)
    else:
        return ''

def get_list_of_part_suffices():
    n = int(get_number_of_parts())
    l = list(range(n))
    return [get_elem_str(elem+1) for elem in l]

