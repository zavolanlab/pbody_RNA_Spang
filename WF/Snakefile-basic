rule remove_adapters:
    """
        Remove remaining poly(A) stretches from 3' end of R1 reads and poly(T) from 5'end of R2 reads if present
    """
    input:
        reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R1.fastq.gz"),
        reads_R2=os.path.join(
            config["output_dir"],
            "fastq",
            "extracted_UMIs",
            "{sample}.R2.fastq.gz"),
    output:
        reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "no_adapters",
            "{sample}.R1.fastq.gz"),
        reads_R2=os.path.join(
            config["output_dir"],
            "fastq",
            "no_adapters",
            "{sample}.R2.fastq.gz"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "fastq",
            "no_adapters"),
        R2_trim5 = lambda wildcards: samples.loc[wildcards.sample, "fq2_trim5"],
        R1_trim5 = lambda wildcards: samples.loc[wildcards.sample, "fq1_trim5"],
        R2_3p = lambda wildcards: samples.loc[wildcards.sample, "fq2_3p"],
        R1_3p = lambda wildcards: samples.loc[wildcards.sample, "fq1_3p"],

